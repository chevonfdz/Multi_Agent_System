# Copy this file to .env and change what you need. Every setting is optional.

# Planner mode: "none" = rule-based (no API key needed), "anthropic" = use Claude
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
# Needed only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Login tokens. Leave empty to have a random secret generated in data/.jwt_secret
JWT_SECRET=
TOKEN_HOURS=24

# Web server
HOST=127.0.0.1
PORT=8000

# Daily refresh (FR-7): time of day, and the time zone (empty = this computer's time zone)
ENABLE_SCHEDULER=true
SCRAPE_HOUR=0
SCRAPE_MINUTE=0
TIMEZONE=
# First start: scrape in the background when a database is empty (if_empty | always | never)
SCRAPE_ON_STARTUP=if_empty
# Minimum seconds between requests to the same website (robots.txt crawl-delay is also respected)
REQUEST_DELAY_SECONDS=1.0

# Agents
AGENT_TIMEOUT_SECONDS=10
RESULTS_PER_CATEGORY=5
HISTORY_CONTEXT_MESSAGES=10
